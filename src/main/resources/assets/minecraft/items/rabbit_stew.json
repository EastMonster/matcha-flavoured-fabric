{
    "model":{
      "type": "select",
      "property": "custom_model_data",
      "fallback": {
        "type": "model",
        "model": "item/rabbit_stew"
      },
      "cases": [
        {
          "when": "ramen",
          "model": {
            "type": "model",
            "model": "item/ramen"
          }
        },
        {
          "when": "green_curry",
          "model": {
            "type": "model",
            "model": "item/green_curry"
          }
        },
        {
          "when": "paneer_makhani",
          "model": {
            "type": "model",
            "model": "item/paneer_makhani"
          }
        }
      ]
    }
  }
